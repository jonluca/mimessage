@@ -262,8 +262,20 @@ CNAuthorizationStatus AuthStatus() {
   return [CNContactStore authorizationStatusForEntityType:entityType];
 }
 
+// Limited Contacts access is represented by status 4 in current Apple SDKs.
+// Use the numeric value so this module continues to compile with older SDKs that
+// do not declare CNAuthorizationStatusLimited for macOS.
+bool HasContactsReadAccess() {
+  CNAuthorizationStatus status = AuthStatus();
+  return status == CNAuthorizationStatusAuthorized ||
+         static_cast<NSInteger>(status) == 4;
+}
+
 // Returns the authorization status as a string.
 std::string AuthStatusString() {
+  if (static_cast<NSInteger>(AuthStatus()) == 4)
+    return "Limited";
+
   switch (AuthStatus()) {
   case CNAuthorizationStatusAuthorized:
     return "Authorized";
