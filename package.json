{
  "private": true,
  "author": "JonLuca DeCaro <mimessage@jonlu.ca>",
  "main": "build/electron-src/index.js",
  "name": "MiMessage",
  "version": "1.2.0-beta.3",
  "productName": "Mimessage",
  "description": "Apple Messages UI alternative, with export, search, and more.",
  "scripts": {
    "patch:contacts": "patch -Nfs -r /dev/null -p1 < patches/electron-mac-contacts+1.1.0.patch || patch -RfsC -p1 < patches/electron-mac-contacts+1.1.0.patch",
    "patch:builder": "patch -Nfs -r /dev/null -p1 < patches/app-builder-lib+26.15.3.patch || patch -RfsC -p1 < patches/app-builder-lib+26.15.3.patch",
    "postinstall": "yarn patch:contacts && yarn patch:builder && node scripts/prepare-native-modules.mjs && electron-builder install-app-deps",
    "build": "yarn build:electron && yarn build:ui",
    "build:electron": "APP_ENV=production tsx scripts/electron.ts build",
    "build:liquid-glass": "node scripts/build-liquid-glass.mjs",
    "build:ui": "APP_ENV=production next build src",
    "fastbuild": "node scripts/fastbuild.mjs",
    "check-signature": "spctl --assess -vvvv dist/mac/Mimessage.app && spctl --assess -vvvv dist/mac-arm64/Mimessage.app && codesign -vvv --deep --strict dist/mac/Mimessage.app && codesign -vvv --deep --strict dist/mac-arm64/Mimessage.app",
    "package": "electron-builder build",
    "notarize": "DEBUG=electron* tsx electron-src/hooks/notarize.ts",
    "start:app": "tsx scripts/electron.ts dev",
    "clean": "rimraf dist build src/out .next src/.next native/liquid-glass/build native/liquid-glass/prebuilds",
    "dev": "yarn start:app",
    "dev:debug": "DEBUG_LOGGING=true yarn start:app",
    "dev:workers": "DEV_WORKERS=true yarn start:app",
    "gen-types": "tsx scripts/gen-types.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix && oxfmt",
    "lint:staged": "lint-staged",
    "stamp:update-metadata": "node scripts/stamp-macos-update-metadata.mjs",
    "test:messages": "ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/message-page-fixture.ts && ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/message-pagination-fixture.ts",
    "test:liquid-glass": "yarn build:liquid-glass && electron native/liquid-glass/smoke-test.cjs",
    "test:semantic": "ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/semantic-search-fixture.ts",
    "test:signing": "node scripts/signing-keychain-fixture.mjs",
    "test:wrapped": "TZ=America/Los_Angeles ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/wrapped-stats-fixture.ts",
    "typecheck": "tsc -p src --noEmit && tsc --noEmit",
    "test:renderer": "node scripts/renderer-performance-fixture.mjs",
    "test:performance": "ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/message-query-performance-fixture.ts",
    "test:snapshots": "ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/db-snapshot-fixture.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-mac-contacts": "^1.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@isoterik/react-word-cloud": "^1.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonexport": "^3.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-highlight-words": "^0.20.1",
    "bplist-universal": "^1.1.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "electron": "^44",
    "electron-builder": "26.15.3",
    "electron-context-menu": "^4.1.2",
    "electron-extension-installer": "^2.0.3",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "electron-worker-threads": "^1.1.1",
    "esbuild": "^0.28.2",
    "execa": "^10.0.1",
    "file-type": "^22.0.2",
    "fs-extra": "^11.4.0",
    "fs-jetpack": "^5.1.0",
    "fuse.js": "^7.5.0",
    "gpt4-tokenizer": "^1.3.1",
    "jsonexport": "^3.2.0",
    "kysely": "^0.29.5",
    "kysely-codegen": "^0.20.0",
    "libphonenumber-js": "^1.13.12",
    "lint-staged": "^17.4.1",
    "lodash-es": "^4.18.1",
    "next": "^16.3.3",
    "node-gyp": "^12.2.0",
    "openai": "^7.8.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "p-ratelimit": "^1.0.1",
    "pretty-ms": "^9.3.1",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-highlight-words": "^0.21.0",
    "react-virtuoso": "^4.18.12",
    "rimraf": "^6.1.3",
    "sql-formatter": "^15.8.2",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.jonluca.mimessage",
    "beforeBuild": "./scripts/prepare-native-modules.mjs",
    "concurrency": {
      "jobs": 1
    },
    "extends": null,
    "productName": "Mimessage",
    "extraMetadata": {
      "name": "Mimessage",
      "productName": "Mimessage"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "!**/*.mk",
      "!**/LICENSE",
      "!**/*.c",
      "!**/*.mm",
      "!**/*.cpp",
      "!**/*.hpp",
      "!**/*.map",
      "!**/*.h",
      "!**/python3",
      "!**/*.{a,iml,o,Makefile,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj,vscode,env.example,oxfmtrc.json,oxlintrc.json,tgz}",
      "!**/._*",
      "!**/.github/**/*",
      "!**/*.d.ts",
      "!**/*.md",
      "!**/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!*.sass",
      "!.editorconfig",
      "!appveyor-tools",
      "!certificates",
      "!custom-typings",
      "!{assets,modules}",
      "assets/**/*",
      "node_modules/**/*.node",
      "!node_modules/**/test_extension.node",
      "build/**/*.js",
      "package.json",
      "src/out/**/*"
    ],
    "extraResources": [
      "assets/**/*"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "native/liquid-glass/prebuilds/darwin-${arch}/mimessage_liquid_glass.node",
          "to": "native/mimessage_liquid_glass.node"
        }
      ],
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "icon": "electron-src/icon.icns",
      "entitlements": "electron-src/entitlements.plist",
      "entitlementsInherit": "electron-src/entitlements.plist",
      "extendInfo": {
        "NSContactsUsageDescription": "Mimessage needs access to your contacts to show you their name.",
        "NSSystemAdministrationUsageDescription": "Mimessage needs access to your files to read your messages."
      },
      "darkModeSupport": true,
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "dmg": {
      "artifactName": "Mimessage-${arch}.dmg",
      "sign": false
    },
    "appImage": {
      "artifactName": "Mimessage-${version}.AppImage"
    },
    "publish": {
      "provider": "github",
      "releaseType": "prerelease"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "yarn@1.22.22",
  "lint-staged": {
    "**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "oxfmt"
    ],
    "**/*.{css,html,json,jsonc,less,md,mdx,scss,yaml,yml}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    "last 1 Chrome versions"
  ]
}
